DATABASE_URL=postgresql://packit:dev_password@localhost:5432/packit
HOST=0.0.0.0
PORT=3000
# Site origin: absolute link-preview URLs and the passkey relying party.
# Must be a bare https:// origin (http://localhost:3000 only with --dev-mode).
PUBLIC_URL=https://potatos.txcl.io
# IP of the reverse proxy (e.g. Traefik) in front of the backend, as the
# backend sees it. REQUIRED in production behind Traefik: without it every
# client shares the proxy's auth rate limits, so one client can lock everyone
# out of signing in. Only requests from this address may name the client, via
# the last X-Forwarded-For entry (single hop). Leave unset only when clients
# connect directly.
# TRUSTED_PROXY=172.18.0.2
SESSION_SECRET=change-me-in-production-at-least-64-bytes-long-xxxxxxxxxxxxxxxxxx
