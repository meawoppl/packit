DATABASE_URL=postgresql://packit:dev_password@localhost:5432/packit
HOST=0.0.0.0
PORT=3000
# Site origin: absolute link-preview URLs and the passkey relying party.
# Must be a bare https:// origin (http://localhost:3000 only with --dev-mode).
PUBLIC_URL=https://potatos.txcl.io
# IP of the reverse proxy (e.g. Traefik) in front of the backend. Only
# requests from this address may name the client via X-Forwarded-For (last
# hop), for auth rate limits. Leave unset when clients connect directly.
# TRUSTED_PROXY=172.18.0.2
SESSION_SECRET=change-me-in-production-at-least-64-bytes-long-xxxxxxxxxxxxxxxxxx
