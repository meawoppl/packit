DATABASE_URL=postgresql://packit:dev_password@localhost:5432/packit
HOST=0.0.0.0
PORT=3000
# Site origin: absolute link-preview URLs and the passkey relying party.
# Must be a bare https:// origin (http://localhost:3000 only with --dev-mode).
PUBLIC_URL=https://potatos.txcl.io
# Proxy trust for auth rate limits. REQUIRED in production behind Traefik:
# without it every client shares the proxy's buckets, so one client can lock
# everyone out of signing in. Trusted requests are keyed on the last
# X-Forwarded-For entry (single hop). Leave both unset only when clients
# connect directly.
#
# Shared secret Traefik writes into X-Packit-Proxy-Token on every request,
# overwriting any client value: 32 random bytes as 64 hex chars
# (openssl rand -hex 32). 32-256 visible ASCII chars, no commas; a bad value
# stops startup. When set, X-Forwarded-For needs exactly this token.
# TRUSTED_PROXY_TOKEN=
# Traefik's IP as the backend sees it. Alone, requests from this peer are
# trusted; with the token set, both must match.
# TRUSTED_PROXY=172.18.0.2
SESSION_SECRET=change-me-in-production-at-least-64-bytes-long-xxxxxxxxxxxxxxxxxx
